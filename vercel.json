{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "aivora-api-server": {
      "root": "server",
      "framework": "express",
      "buildCommand": "node -v"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "aivora-api-server"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "aivora-api-server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "aivora-api-server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "aivora-api-server"
      }
    }
  ]
}
